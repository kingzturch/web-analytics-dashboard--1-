# Pulse Analytics Production Environment Variables Template v1.0.0

PORT=3000
NODE_ENV=production

# Supabase Storage & Database Connection
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Collector API & SDK Configuration
VITE_COLLECTOR_URL=https://your-domain.com
VITE_PULSE_SDK_VERSION=1.0.0
VITE_PULSE_COLLECTOR_VERSION=1.0.0-RC3
PULSE_SDK_VERSION=1.0.0
PULSE_COLLECTOR_VERSION=1.0.0-RC3

# Ingestion Queue & Worker Tuning
INGESTION_QUEUE_BATCH_SIZE=50
INGESTION_QUEUE_FLUSH_MS=500
INGESTION_QUEUE_MAX_RETRY=5

# Rate Limiting & Security
RATE_LIMIT_IP_PER_MIN=100
RATE_LIMIT_KEY_PER_MIN=1000
ALLOWED_ORIGINS=https://your-domain.com,https://app.your-domain.com

